# Environment Variables — DSD Security Frontend
# Copy this file to .env and fill in values

# Application name shown in metadata
VITE_APP_NAME=

# Backend REST API base URL
VITE_API_URL=http://localhost:5000/api

# Google Maps embed key (leave blank to use radar placeholder)
VITE_GOOGLE_MAPS_KEY=

# Contact form email (server-side only — never prefix these with VITE_)
# SMTP_USER is the Gmail account that SENDS the mail; SMTP_PASS is its 16-char App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Inbox that receives contact form submissions
CONTACT_TO_EMAIL=dsdsecurityservices@gmail.com
